generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         String     @default("REVIEWER") // ADMIN, REVIEWER, VIEWER
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  approvals    Approval[]
}

model Lead {
  id                 String             @id @default(cuid())
  fullName           String
  workEmail          String
  normalizedEmail    String
  phoneNumber        String?
  normalizedPhone    String?
  companyName        String
  companyWebsite     String?
  industry           String
  companySize        String
  serviceRequired    String
  budgetRange        String
  desiredTimeline    String
  decisionAuthority  String
  projectDescription String
  leadSource         String
  idempotencyKey     String?            @unique
  status             String             @default("NEW") // NEW, SCORED, IN_REVIEW, APPROVED, REJECTED, ARCHIVED
  category           String?            // HOT, WARM, COLD, REVIEW_REQUIRED
  totalScore         Int?
  isDuplicate        Boolean            @default(false)
  duplicateOfId      String?
  crmSyncStatus      String             @default("PENDING") // PENDING, SYNCED, FAILED
  crmExternalId      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  scores             LeadScore[]
  followUps          FollowUp[]
  approvals          Approval[]
  integrationEvents  IntegrationEvent[]

  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([createdAt])
  @@index([status])
  @@index([category])
  @@index([crmSyncStatus])
}

model LeadScore {
  id                 String   @id @default(cuid())
  leadId             String
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  budgetFitScore     Int
  serviceFitScore    Int
  urgencyScore       Int
  authorityScore     Int
  infoQualityScore   Int
  totalScore         Int
  category           String
  confidence         Float
  summary            String
  scoreBreakdownJson String   @db.Text
  risksJson          String   @db.Text
  missingInfoJson    String   @db.Text
  recommendedAction  String
  aiProvider         String
  aiModel            String
  promptVersion      String
  isDemoMode         Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model ScoringRule {
  id           String   @id @default(cuid())
  criterionKey String   @unique // budgetFit, serviceFit, urgency, authority, infoQuality
  name         String
  maxScore     Int
  weight       Float
  configJson   String   @db.Text
  updatedBy    String
  updatedAt    DateTime @updatedAt
}

model FollowUp {
  id             String    @id @default(cuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject        String
  body           String    @db.Text
  category       String
  status         String    @default("DRAFT") // DRAFT, APPROVED, SENT, FAILED
  sentAt         DateTime?
  emailAdapter   String    @default("Mailpit")
  recipientEmail String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Approval {
  id               String   @id @default(cuid())
  leadId           String
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  action           String   // APPROVE, REJECT, ADJUST_SCORE, REQUEST_INFO
  previousCategory String?
  newCategory      String?
  previousScore    Int?
  newScore         Int?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
}

model IntegrationEvent {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  system      String    // CRM, MAILPIT, SLACK, N8N
  eventType   String
  status      String    @default("PENDING") // SUCCESS, FAILED, RETRYING
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?   @db.Text
  nextRetryAt DateTime?
  payloadJson String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([nextRetryAt])
}

model WorkflowRun {
  id           String    @id @default(cuid())
  workflowName String
  executionId  String?
  status       String    // SUCCESS, FAILED, RUNNING
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  detailsJson  String?   @db.Text

  @@index([status])
  @@index([startedAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  userEmail     String?
  action        String
  entityType    String
  entityId      String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  reason        String?  @db.Text
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  type      String   // HOT_LEAD, REVIEW_NEEDED, SYNC_ERROR, SYSTEM
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson String   @db.Text
  updatedAt DateTime @updatedAt
}
