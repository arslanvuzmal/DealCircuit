{
  "name": "LeadPilot AI - Failed Event Retry Workflow",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      },
      "name": "Schedule Trigger (Every 15m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/retry-failed-events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }
          ]
        }
      },
      "name": "Trigger Application Event Retry Handler",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [320, 300]
    }
  ],
  "connections": {
    "Schedule Trigger (Every 15m)": {
      "main": [[{ "node": "Trigger Application Event Retry Handler", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
