{
  "name": "LeadPilot AI - Lead Intake Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "options": {}
      },
      "name": "Lead Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300],
      "webhookId": "lead-intake-webhook"
    },
    {
      "parameters": {
        "functionCode": "// Normalize the inbound webhook payload.\n// Actual X-Internal-Secret authentication happens server-side on each\n// /api/internal/* call below (see the HTTP Request nodes' header\n// parameters) - a Function node's code body cannot evaluate {{ }}\n// expressions, so no secret comparison is attempted here.\nconst headers = $input.item.json.headers || {};\nconst body = $input.item.json.body || {};\n\nreturn {\n  json: {\n    event: 'LEAD_SUBMISSION',\n    leadData: body,\n    timestamp: new Date().toISOString(),\n    idempotencyKey: headers['x-idempotency-key'] || body.idempotencyKey || null\n  }\n};"
      },
      "name": "Validate & Normalize Event",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [320, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/score-lead",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.leadData) }}",
        "options": {
          "timeout": 30000
        }
      },
      "name": "Call Lead Qualification Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [540, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.category }}",
              "operation": "equal",
              "value2": "HOT"
            },
            {
              "value1": "={{ $json.category }}",
              "operation": "equal",
              "value2": "WARM"
            }
          ]
        }
      },
      "name": "Filter Category (HOT/WARM)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [760, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/sync-crm",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.leadId }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "name": "Sync Lead to CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [980, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/record-workflow-run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflowName: 'lead-intake', status: 'SUCCESS', details: $json }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "name": "Record Success Execution Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "functionCode": "const error = $input.item.json.error || $input.item.json.message || 'Unknown error';\nreturn {\n  json: {\n    workflowName: 'lead-intake',\n    status: 'FAILED',\n    details: { error, node: 'Call Lead Qualification Engine' }\n  }\n};"
      },
      "name": "Format Qualification Error",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [760, 450]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/record-workflow-run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000
        }
      },
      "name": "Record Qualification Failure Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [980, 450]
    },
    {
      "parameters": {
        "functionCode": "const error = $input.item.json.error || $input.item.json.message || 'Unknown error';\nreturn {\n  json: {\n    workflowName: 'lead-intake',\n    status: 'FAILED',\n    details: { error, node: 'Sync Lead to CRM' }\n  }\n};"
      },
      "name": "Format CRM Sync Error",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1200, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/record-workflow-run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000
        }
      },
      "name": "Record CRM Sync Failure Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1420, 100]
    }
  ],
  "connections": {
    "Lead Intake Webhook": {
      "main": [[{ "node": "Validate & Normalize Event", "type": "main", "index": 0 }]]
    },
    "Validate & Normalize Event": {
      "main": [[{ "node": "Call Lead Qualification Engine", "type": "main", "index": 0 }]]
    },
    "Call Lead Qualification Engine": {
      "main": [[{ "node": "Filter Category (HOT/WARM)", "type": "main", "index": 0 }]],
      "error": [[{ "node": "Format Qualification Error", "type": "main", "index": 0 }]]
    },
    "Filter Category (HOT/WARM)": {
      "main": [
        [{ "node": "Sync Lead to CRM", "type": "main", "index": 0 }],
        [{ "node": "Record Success Execution Log", "type": "main", "index": 0 }]
      ]
    },
    "Sync Lead to CRM": {
      "main": [[{ "node": "Record Success Execution Log", "type": "main", "index": 0 }]],
      "error": [[{ "node": "Format CRM Sync Error", "type": "main", "index": 0 }]]
    },
    "Format Qualification Error": {
      "main": [[{ "node": "Record Qualification Failure Log", "type": "main", "index": 0 }]]
    },
    "Format CRM Sync Error": {
      "main": [[{ "node": "Record CRM Sync Failure Log", "type": "main", "index": 0 }]]
    },
    "Record Success Execution Log": {
      "main": []
    },
    "Record Qualification Failure Log": {
      "main": []
    },
    "Record CRM Sync Failure Log": {
      "main": []
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}