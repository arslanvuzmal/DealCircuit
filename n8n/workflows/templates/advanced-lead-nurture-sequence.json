{
  "name": "LeadPilot AI - Advanced Multi-Touch Nurture Sequence",
  "meta": {
    "description": "Portfolio template: a long-running, time-delayed nurture cadence for WARM and COLD leads that didn't convert on first contact. Demonstrates branching by category, staged Wait delays, engagement-based Switch routing, and re-scoring on late response. Not part of the 4 core application-contract workflows - kept under templates/ as a complexity showcase.",
    "nodeCount": 27
  },
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 6 }] } },
      "name": "Schedule Trigger (Every 6h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [80, 500]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/leads?status=SCORED&category=WARM,COLD",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] }
      },
      "name": "Fetch Eligible Nurture Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [300, 500]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "name": "Split In Batches (Per Lead)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [520, 500]
    },
    {
      "parameters": {
        "conditions": { "string": [{ "value1": "={{ $json.category }}", "operation": "equal", "value2": "WARM" }] }
      },
      "name": "Filter: WARM vs COLD Track",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [740, 500]
    },
    {
      "parameters": { "keepOnlySet": false, "values": { "string": [{ "name": "touchNumber", "value": "1" }, { "name": "template", "value": "warm_touch_1_reengagement" }] } },
      "name": "WARM: Prepare Touch 1",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [960, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/generate-follow-up",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id, template: $json.template }) }}"
      },
      "name": "Send WARM Touch 1 Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1180, 260]
    },
    {
      "parameters": { "amount": 3, "unit": "days" },
      "name": "Wait 3 Days (Post Touch 1)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1400, 260]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/leads/{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] }
      },
      "name": "Check Engagement Signal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1620, 260]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.engagementLevel || 'none' }}",
        "rules": {
          "rules": [
            { "value2": "high", "output": 0 },
            { "value2": "medium", "output": 1 },
            { "value2": "none", "output": 2 }
          ]
        },
        "fallbackOutput": 2
      },
      "name": "Switch: Engagement Level",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [1840, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/send-notification",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'SLACK_ALERT', title: 'Hot Re-engagement', leadId: $json.id }) }}"
      },
      "name": "High Engagement: Alert Sales Rep",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2060, 80]
    },
    {
      "parameters": { "keepOnlySet": false, "values": { "string": [{ "name": "touchNumber", "value": "2" }, { "name": "template", "value": "warm_touch_2_case_study" }] } },
      "name": "Medium: Prepare Touch 2 (Case Study)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [2060, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/generate-follow-up",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id, template: $json.template }) }}"
      },
      "name": "Send Touch 2 (Case Study)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2280, 260]
    },
    {
      "parameters": { "amount": 5, "unit": "days" },
      "name": "Wait 5 Days (Post Touch 2)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [2500, 260]
    },
    {
      "parameters": { "conditions": { "boolean": [{ "value1": "={{ $json.responded || false }}", "value2": true }] } },
      "name": "IF: Responded After Touch 2",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2720, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/score-lead",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id }) }}"
      },
      "name": "Re-score On Late Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2940, 160]
    },
    {
      "parameters": { "keepOnlySet": false, "values": { "string": [{ "name": "nurtureOutcome", "value": "moved_to_cold_nurture" }] } },
      "name": "No Response: Move to Long-Term Nurture",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [2940, 360]
    },
    {
      "parameters": { "keepOnlySet": false, "values": { "string": [{ "name": "touchNumber", "value": "1" }, { "name": "template", "value": "cold_quarterly_checkin" }] } },
      "name": "COLD: Prepare Long-Cadence Touch",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [960, 640]
    },
    {
      "parameters": { "amount": 14, "unit": "days" },
      "name": "Wait 14 Days (COLD Cadence)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1180, 640]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/generate-follow-up",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id, template: $json.template }) }}"
      },
      "name": "Send Quarterly Check-in",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1400, 640]
    },
    {
      "parameters": { "conditions": { "boolean": [{ "value1": "={{ $json.responded || false }}", "value2": true }] } },
      "name": "IF: COLD Lead Responded",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1620, 640]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/score-lead",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id }) }}"
      },
      "name": "Re-score Reactivated COLD Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1840, 560]
    },
    {
      "parameters": {
        "conditions": { "string": [{ "value1": "={{ $json.category }}", "operation": "notEqual", "value2": "COLD" }] }
      },
      "name": "IF: Re-scored Above COLD",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2060, 560]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/send-notification",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'SLACK_ALERT', title: 'Cold Lead Reactivated', leadId: $json.id }) }}"
      },
      "name": "Notify: Cold Lead Reactivated",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2280, 460]
    },
    {
      "parameters": {},
      "name": "No-Op: Continue Long-Term Nurture Loop",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2280, 660]
    },
    {
      "parameters": {},
      "name": "Merge All Nurture Branches",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [3160, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/record-workflow-run",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflowName: 'advanced-lead-nurture-sequence', status: 'SUCCESS', details: $json }) }}"
      },
      "name": "Record Workflow Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [3380, 400]
    },
    {
      "parameters": {
        "batchSize": 1
      },
      "name": "Next Lead In Batch",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [3600, 400]
    }
  ],
  "connections": {
    "Schedule Trigger (Every 6h)": { "main": [[{ "node": "Fetch Eligible Nurture Leads", "type": "main", "index": 0 }]] },
    "Fetch Eligible Nurture Leads": { "main": [[{ "node": "Split In Batches (Per Lead)", "type": "main", "index": 0 }]] },
    "Split In Batches (Per Lead)": { "main": [[{ "node": "Filter: WARM vs COLD Track", "type": "main", "index": 0 }]] },
    "Filter: WARM vs COLD Track": {
      "main": [
        [{ "node": "WARM: Prepare Touch 1", "type": "main", "index": 0 }],
        [{ "node": "COLD: Prepare Long-Cadence Touch", "type": "main", "index": 0 }]
      ]
    },
    "WARM: Prepare Touch 1": { "main": [[{ "node": "Send WARM Touch 1 Email", "type": "main", "index": 0 }]] },
    "Send WARM Touch 1 Email": { "main": [[{ "node": "Wait 3 Days (Post Touch 1)", "type": "main", "index": 0 }]] },
    "Wait 3 Days (Post Touch 1)": { "main": [[{ "node": "Check Engagement Signal", "type": "main", "index": 0 }]] },
    "Check Engagement Signal": { "main": [[{ "node": "Switch: Engagement Level", "type": "main", "index": 0 }]] },
    "Switch: Engagement Level": {
      "main": [
        [{ "node": "High Engagement: Alert Sales Rep", "type": "main", "index": 0 }],
        [{ "node": "Medium: Prepare Touch 2 (Case Study)", "type": "main", "index": 0 }],
        [{ "node": "Medium: Prepare Touch 2 (Case Study)", "type": "main", "index": 0 }]
      ]
    },
    "High Engagement: Alert Sales Rep": { "main": [[{ "node": "Merge All Nurture Branches", "type": "main", "index": 0 }]] },
    "Medium: Prepare Touch 2 (Case Study)": { "main": [[{ "node": "Send Touch 2 (Case Study)", "type": "main", "index": 0 }]] },
    "Send Touch 2 (Case Study)": { "main": [[{ "node": "Wait 5 Days (Post Touch 2)", "type": "main", "index": 0 }]] },
    "Wait 5 Days (Post Touch 2)": { "main": [[{ "node": "IF: Responded After Touch 2", "type": "main", "index": 0 }]] },
    "IF: Responded After Touch 2": {
