      ]
    },
    "Re-score On Late Response": { "main": [[{ "node": "Merge All Nurture Branches", "type": "main", "index": 1 }]] },
    "No Response: Move to Long-Term Nurture": { "main": [[{ "node": "Merge All Nurture Branches", "type": "main", "index": 1 }]] },
    "COLD: Prepare Long-Cadence Touch": { "main": [[{ "node": "Wait 14 Days (COLD Cadence)", "type": "main", "index": 0 }]] },
    "Wait 14 Days (COLD Cadence)": { "main": [[{ "node": "Send Quarterly Check-in", "type": "main", "index": 0 }]] },
