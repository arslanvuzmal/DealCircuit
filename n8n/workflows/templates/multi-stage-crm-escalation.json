      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [2080, 500]
    },
    {
      "parameters": {
        "conditions": { "number": [{ "value1": "={{ $json.attempts || 1 }}", "operation": "largerEqual", "value2": 3 }] }
