    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/leads/{{ $json.leadId }}/reprocess",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] }
      },
      "name": "Flag Lead for Manual Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2520, 420]
    },
    {
