{
  "name": "LeadPilot AI - Multi-Stage CRM Sync Escalation & Resilience",
  "meta": {
    "description": "Portfolio template: resilient CRM synchronization with error-type-aware retry strategy, exponential backoff, and human escalation on repeated failure. Demonstrates Switch-based error classification, differentiated Wait/retry cadences per failure type, and a maxAttempts escalation gate. Not part of the 4 core application-contract workflows - kept under templates/ as a complexity showcase.",
    "nodeCount": 24
  },
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "crm-sync-escalation", "options": {} },
      "name": "CRM Sync Request Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [80, 460],
      "webhookId": "crm-sync-escalation-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/sync-crm",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.body.leadId }) }}",
        "options": { "timeout": 10000 }
      },
      "name": "Attempt Primary CRM Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [300, 460]
    },
    {
      "parameters": { "conditions": { "boolean": [{ "value1": "={{ $json.success || false }}", "value2": true }] } },
      "name": "IF: Sync Succeeded",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [520, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/record-workflow-run",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflowName: 'crm-sync-escalation', status: 'SUCCESS', details: $json }) }}"
      },
      "name": "Record Success Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [740, 260]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.errorType || 'UNKNOWN' }}",
        "rules": {
          "rules": [
            { "value2": "AUTH_ERROR", "output": 0 },
            { "value2": "RATE_LIMIT", "output": 1 },
            { "value2": "TIMEOUT", "output": 2 }
          ]
        },
        "fallbackOutput": 3
      },
      "name": "Switch: Classify Error Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [740, 560]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/send-notification",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'SLACK_ALERT', title: 'CRM Credentials Likely Expired', leadId: $json.leadId }) }}"
      },
      "name": "AUTH_ERROR: Alert Ops (Credentials)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [960, 100]
    },
