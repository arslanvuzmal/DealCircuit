{
  "name": "LeadPilot AI - Enterprise Lead Scoring Orchestration",
  "meta": {
    "description": "Portfolio template: runs deterministic and AI scoring in parallel, reconciles discrepancies, applies confidence-based review routing, then fans out into three category-specific parallel action chains (HOT/WARM/COLD). The most complex of the three showcase templates - demonstrates true parallel branches (not just sequential IF/Switch), a Merge-based reconciliation step, and nested fan-out/fan-in. Not part of the 4 core application-contract workflows - kept under templates/ as a complexity showcase.",
    "nodeCount": 30
  },
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "orchestrated-scoring", "options": {} },
      "name": "Orchestrated Scoring Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [60, 520],
      "webhookId": "orchestrated-scoring-webhook"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/leads/{{ $json.body.leadId }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] }
      },
      "name": "Fetch Lead Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [280, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/score-lead",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }, { "name": "X-Scoring-Mode", "value": "deterministic" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id }) }}"
      },
      "name": "Parallel: Deterministic Score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [520, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/score-lead",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }, { "name": "X-Scoring-Mode", "value": "ai" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id }) }}",
        "options": { "timeout": 15000 }
      },
      "name": "Parallel: AI Score (with timeout)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [520, 660]
    },
    {
      "parameters": {},
      "name": "Merge: Combine Score Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [760, 520]
    },
    {
      "parameters": {
        "functionCode": "// Compute discrepancy between deterministic and AI scores.\nconst det = $input.all()[0]?.json?.totalScore ?? 0;\nconst ai = $input.all()[1]?.json?.totalScore ?? det;\nconst delta = Math.abs(det - ai);\nreturn { json: { ...$input.all()[0].json, deterministicScore: det, aiScore: ai, discrepancyDelta: delta } };"
      },
      "name": "Compute Score Discrepancy",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [980, 520]
    },
    {
      "parameters": { "conditions": { "number": [{ "value1": "={{ $json.discrepancyDelta }}", "operation": "larger", "value2": 15 }] } },
      "name": "IF: Discrepancy Exceeds Threshold",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1200, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/send-notification",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'REVIEW_NEEDED', title: 'Deterministic/AI Score Discrepancy Flagged', leadId: $json.id }) }}"
      },
      "name": "Flag Discrepancy for Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1420, 400]
    },
    {
      "parameters": { "keepOnlySet": false, "values": { "number": [{ "name": "finalScore", "value": "={{ $json.deterministicScore }}" }], "string": [{ "name": "scoreSource", "value": "deterministic_safety_fallback" }] } },
      "name": "Trust Deterministic (Safety Default)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1640, 400]
    },
    {
      "parameters": { "keepOnlySet": false, "values": { "number": [{ "name": "finalScore", "value": "={{ Math.round(($json.deterministicScore + $json.aiScore) / 2) }}" }], "string": [{ "name": "scoreSource", "value": "weighted_average" }] } },
      "name": "Compute Weighted Average Score",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1420, 620]
    },
    {
      "parameters": {},
      "name": "Merge: Score Reconciliation Complete",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [1860, 520]
    },
    {
      "parameters": { "conditions": { "number": [{ "value1": "={{ $json.confidence || 1 }}", "operation": "smaller", "value2": 0.6 }] } },
      "name": "IF: Low Confidence",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2080, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/leads/{{ $json.id }}/reprocess",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] }
      },
      "name": "Low Confidence: Route to Human Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2300, 380]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.category }}",
        "rules": {
          "rules": [
            { "value2": "HOT", "output": 0 },
            { "value2": "WARM", "output": 1 },
            { "value2": "COLD", "output": 2 }
          ]
        },
        "fallbackOutput": 3
      },
      "name": "Switch: Category Fan-Out",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [2300, 620]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/generate-follow-up",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id }) }}"
      },
      "name": "HOT: Generate Priority Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2520, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/sync-crm",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id, priority: 'high' }) }}"
      },
      "name": "HOT: Sync CRM (High Priority)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2520, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/send-notification",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'HOT_LEAD', title: 'Hot Lead - Immediate Sales Attention', leadId: $json.id }) }}"
      },
      "name": "HOT: Notify Sales Immediately",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2520, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/generate-follow-up",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id }) }}"
      },
      "name": "WARM: Generate Standard Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2520, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/sync-crm",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id, priority: 'standard' }) }}"
      },
      "name": "WARM: Sync CRM (Standard)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2520, 560]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/webhook/lead-intake",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id, trigger: 'nurture_sequence' }) }}"
      },
      "name": "WARM: Schedule Nurture Sequence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2520, 660]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/sync-crm",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.id, priority: 'low' }) }}"
      },
      "name": "COLD: Sync CRM (Low Priority)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2520, 800]
    },
    {
      "parameters": { "keepOnlySet": false, "values": { "string": [{ "name": "nurtureTrack", "value": "long_term_list" }] } },
      "name": "COLD: Add to Long-Term Nurture List",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [2520, 900]
    },
    {
      "parameters": {},
      "name": "Merge: Fan-In All Category Actions",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [2760, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/record-workflow-run",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflowName: 'enterprise-lead-scoring-orchestration', status: 'SUCCESS', details: $json }) }}"
      },
      "name": "Record Workflow Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2980, 520]
    },
    {
      "parameters": {
        "functionCode": "// Full score-breakdown audit trail: deterministic vs AI vs final reconciled score.\nreturn { json: { auditAction: 'ORCHESTRATED_SCORE_COMPLETE', leadId: $json.id, deterministicScore: $json.deterministicScore, aiScore: $json.aiScore, finalScore: $json.finalScore, scoreSource: $json.scoreSource } };"
      },
      "name": "Build Full Score Audit Trail",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [3200, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPLICATION_URL || 'http://localhost:3000' }}/api/internal/send-notification",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Secret", "value": "={{ $env.INTERNAL_API_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'SYSTEM', title: 'Orchestration Complete', leadId: $json.leadId }) }}"
      },
      "name": "Log Audit Event (Score Trail)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [3420, 520]
    }
  ],
  "connections": {
    "Orchestrated Scoring Trigger": { "main": [[{ "node": "Fetch Lead Details", "type": "main", "index": 0 }]] },
    "Fetch Lead Details": {
      "main": [
        [
          { "node": "Parallel: Deterministic Score", "type": "main", "index": 0 },
          { "node": "Parallel: AI Score (with timeout)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Parallel: Deterministic Score": { "main": [[{ "node": "Merge: Combine Score Results", "type": "main", "index": 0 }]] },
    "Parallel: AI Score (with timeout)": { "main": [[{ "node": "Merge: Combine Score Results", "type": "main", "index": 1 }]] },
    "Merge: Combine Score Results": { "main": [[{ "node": "Compute Score Discrepancy", "type": "main", "index": 0 }]] },
    "Compute Score Discrepancy": { "main": [[{ "node": "IF: Discrepancy Exceeds Threshold", "type": "main", "index": 0 }]] },
    "IF: Discrepancy Exceeds Threshold": {
      "main": [
        [{ "node": "Flag Discrepancy for Review", "type": "main", "index": 0 }],
        [{ "node": "Compute Weighted Average Score", "type": "main", "index": 0 }]
      ]
    },
    "Flag Discrepancy for Review": { "main": [[{ "node": "Trust Deterministic (Safety Default)", "type": "main", "index": 0 }]] },
    "Trust Deterministic (Safety Default)": { "main": [[{ "node": "Merge: Score Reconciliation Complete", "type": "main", "index": 0 }]] },
    "Compute Weighted Average Score": { "main": [[{ "node": "Merge: Score Reconciliation Complete", "type": "main", "index": 0 }]] },
    "Merge: Score Reconciliation Complete": { "main": [[{ "node": "IF: Low Confidence", "type": "main", "index": 0 }]] },
    "IF: Low Confidence": {
      "main": [
        [{ "node": "Low Confidence: Route to Human Review", "type": "main", "index": 0 }],
        [{ "node": "Switch: Category Fan-Out", "type": "main", "index": 0 }]
      ]
    },
    "Low Confidence: Route to Human Review": { "main": [[{ "node": "Merge: Fan-In All Category Actions", "type": "main", "index": 0 }]] },
    "Switch: Category Fan-Out": {
      "main": [
        [
          { "node": "HOT: Generate Priority Follow-up", "type": "main", "index": 0 },
          { "node": "HOT: Sync CRM (High Priority)", "type": "main", "index": 0 },
          { "node": "HOT: Notify Sales Immediately", "type": "main", "index": 0 }
        ],
        [
          { "node": "WARM: Generate Standard Follow-up", "type": "main", "index": 0 },
          { "node": "WARM: Sync CRM (Standard)", "type": "main", "index": 0 },
          { "node": "WARM: Schedule Nurture Sequence", "type": "main", "index": 0 }
        ],
        [
          { "node": "COLD: Sync CRM (Low Priority)", "type": "main", "index": 0 },
          { "node": "COLD: Add to Long-Term Nurture List", "type": "main", "index": 0 }
        ]
      ]
    },
    "HOT: Generate Priority Follow-up": { "main": [[{ "node": "Merge: Fan-In All Category Actions", "type": "main", "index": 0 }]] },
    "HOT: Sync CRM (High Priority)": { "main": [[{ "node": "Merge: Fan-In All Category Actions", "type": "main", "index": 0 }]] },
    "HOT: Notify Sales Immediately": { "main": [[{ "node": "Merge: Fan-In All Category Actions", "type": "main", "index": 0 }]] },
    "WARM: Generate Standard Follow-up": { "main": [[{ "node": "Merge: Fan-In All Category Actions", "type": "main", "index": 0 }]] },
    "WARM: Sync CRM (Standard)": { "main": [[{ "node": "Merge: Fan-In All Category Actions", "type": "main", "index": 0 }]] },
    "WARM: Schedule Nurture Sequence": { "main": [[{ "node": "Merge: Fan-In All Category Actions", "type": "main", "index": 0 }]] },
    "COLD: Sync CRM (Low Priority)": { "main": [[{ "node": "Merge: Fan-In All Category Actions", "type": "main", "index": 0 }]] },
    "COLD: Add to Long-Term Nurture List": { "main": [[{ "node": "Merge: Fan-In All Category Actions", "type": "main", "index": 0 }]] },
    "Merge: Fan-In All Category Actions": { "main": [[{ "node": "Record Workflow Run", "type": "main", "index": 0 }]] },
    "Record Workflow Run": { "main": [[{ "node": "Build Full Score Audit Trail", "type": "main", "index": 0 }]] },
    "Build Full Score Audit Trail": { "main": [[{ "node": "Log Audit Event (Score Trail)", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
