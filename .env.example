# DealCircuit Environment Variables

# Database Connection (PostgreSQL for Production, SQLite for local dev)
DATABASE_URL=""
DIRECT_URL=""

# Operational Mode
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"

# Security & Authentication Secrets
JWT_SECRET=""
INTERNAL_API_SECRET=""

# Application Host URLs
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Provider API Keys (Optional in Demo Mode)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Local Mailpit SMTP Adapter Configuration
MAILPIT_SMTP_HOST="localhost"
MAILPIT_SMTP_PORT="1025"
MAILPIT_UI_URL="http://localhost:8025"

# n8n Automation Webhook Integration
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

# Feature Flags & Guards
DEMO_CRM_ENABLED="true"
ALLOW_PRODUCTION_SEED="false"
